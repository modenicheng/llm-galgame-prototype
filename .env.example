# LLM (story generation) — BigModel（智谱）OpenAI 兼容端点
# config.yaml 的 api.base_url 指向 https://open.bigmodel.cn/api/coding/paas/v4
VIBEGAL_LLM_KEY=YOUR_BIGMODEL_KEY_HERE

# DashScope CosyVoice 3 (TTS; optional — media.audio.synthesis.provider=dashscope)
# 注意：本项目合成链路使用北京地域的 SpeechSynthesizer 端点（API Key 需为北京地域）。
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_KEY_HERE
# voice-id 三种来源（全部只需把 id 填到对应变量即可）：
#   1. 系统音色：音色列表中的字面量，如 COSYVOICE_VOICE_SYSTEM_SAMPLE=longanyang
#   2. 控制台复刻：百炼控制台 → 复刻音色 → 上传 10~20 秒音频 → 复制生成的 voice-id
#   3. 控制台设计：百炼控制台 → 设计音色 → 填写声音描述 → 复制生成的 voice-id
# voice-id 格式示例：cosyvoice-v3-flash-suyao-xxxxxx（必须与 voices.yaml 中的 model 匹配）
COSYVOICE_VOICE_SUYAO=
COSYVOICE_VOICE_LINCHE=
COSYVOICE_VOICE_SYSTEM_SAMPLE=longanyang
# 动态生成世界（编剧音频画像）角色的共享回退音色：需与 synthesis.model_profile
# 配对（系统音色即可，画像经 instruction 传导）；留空 = 动态角色不配音。
# DASHSCOPE_VOICE_FALLBACK=longxiaochun_v3
# 可选：覆盖默认的北京 SpeechSynthesizer 端点（业务空间专属域名）
# DASHSCOPE_TTS_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer

# 本地 Qwen3-TTS 推理服务（optional — media.audio.synthesis.provider=local；
# 音色走 voices.yaml 的 providers.local，无需任何 key。可选覆盖：）
# LOCAL_TTS_BASE_URL=http://127.0.0.1:9766
# LOCAL_TTS_DIALECT=openai   # openai=/v1/audio/speech（默认）；tts-server=POST /tts（Python 引擎）

# ---- 图像生成（gpt-image-2 / 2.5，src/tools/image-gen；官方或 OpenAI 兼容中转均可）----
# API 地址：填到 /v1 这一层（工具会拼接 /images/generations 等路径）
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_API_KEY=YOUR_IMAGE_API_KEY_HERE
# IMAGE_GEN_MODEL=gpt-image-2
# IMAGE_GEN_SIZE=auto
# IMAGE_GEN_QUALITY=auto
# IMAGE_GEN_TIMEOUT_MS=300000
# IMAGE_GEN_MAX_RETRIES=2
# IMAGE_GEN_OUTPUT_DIR=output/image-gen
# 可选：抠图引擎 ai（默认，ISNet 软边，推荐）/ flood（纯几何离线）
# IMAGE_GEN_CUTOUT_ENGINE=ai
# IMAGE_GEN_CUTOUT_DEVICE=cpu
# 可选：独立 .onnx 模型文件路径（缺省用 imgly 包内自带的模型资源，无需下载）
# IMAGE_GEN_CUTOUT_MODEL_PATH=
