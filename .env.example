# LLM (story generation)
OPENAI_API_KEY=YOUR_APIKEY_HERE

# DashScope TTS（可选 — media.audio.synthesis.provider=dashscope）
# 注意：两个模型族端点与地域要求见 voices.yaml 头部注释（API Key 需为北京地域）。
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_KEY_HERE
# ---- 模型族 A：CosyVoice（SpeechSynthesizer 端点，支持 rate/pitch/volume/seed）----
# voice-id 三种来源（把 id 填到对应变量即可）：
#   1. 系统音色：如 COSYVOICE_VOICE_SYSTEM_SAMPLE=longanyang
#   2. 控制台复刻：百炼控制台 → 选 cosyvoice 模型 → 复刻音色 → 复制 voice-id
#   3. 控制台设计：百炼控制台 → 选 cosyvoice 模型 → 设计音色 → 复制 voice-id
# voice-id 格式示例：cosyvoice-v3-flash-suyao-xxxxxx（必须与 voices.yaml 的 model 匹配）
COSYVOICE_VOICE_SUYAO=
COSYVOICE_VOICE_LINCHE=
COSYVOICE_VOICE_SYSTEM_SAMPLE=longanyang
# ---- 模型族 B：qwen3-tts（multimodal-generation 端点，固定 24000 Hz PCM 输出）----
# ⚠ qwen3 与 cosyvoice 的复刻/设计音色不互用：需在百炼控制台对 qwen3-tts 系模型
#   重新复刻/设计（参考音频 ≥24kHz 单声道；系统音色如 Cherry 直接填字面量）。
# ⚠ 启用 qwen3 档案时 config.yaml 需设 media.audio.synthesis.sample_rate: 24000。
# 系统音色示例：QWEN3_VOICE_SYSTEM_SAMPLE=Cherry
QWEN3_VOICE_SUYAO=
QWEN3_VOICE_LINCHE=
QWEN3_VOICE_SYSTEM_SAMPLE=Cherry
# 可选：覆盖默认端点（业务空间专属域名）
# DASHSCOPE_TTS_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
# DASHSCOPE_QWEN3_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# ---- 图像生成（gpt-image-2 / 2.5，src/tools/image-gen；官方或 OpenAI 兼容中转均可）----
# API 地址：填到 /v1 这一层（工具会拼接 /images/generations 等路径）
IMAGE_GEN_BASE_URL=https://api.openai.com/v1
# API Key：与上面的 BASE_URL 配套（.env 已被 .gitignore 忽略，不会入库）
IMAGE_GEN_API_KEY=YOUR_IMAGE_API_KEY_HERE
# 可选：参数默认值的中间层（CLI 显式参数优先于这里）
# IMAGE_GEN_MODEL=gpt-image-2
# IMAGE_GEN_SIZE=auto
# IMAGE_GEN_QUALITY=auto
# 可选：客户端行为（毫秒 / 次数）
# IMAGE_GEN_TIMEOUT_MS=300000
# IMAGE_GEN_MAX_RETRIES=2
# 可选：生成结果输出目录
# IMAGE_GEN_OUTPUT_DIR=output/image-gen
# 可选：抠图引擎 ai（默认，ISNet 软边，推荐）/ flood（纯几何离线）
# IMAGE_GEN_CUTOUT_ENGINE=ai
# 可选：AI 抠图执行设备 cpu（默认）/ dml（DirectML；推理快约 7 倍但初始化约 14s，适合批量）
# IMAGE_GEN_CUTOUT_DEVICE=cpu
# 可选：独立 .onnx 模型文件路径（缺省用 imgly 包内自带的模型资源，无需下载）
# IMAGE_GEN_CUTOUT_MODEL_PATH=
