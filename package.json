{
  "name": "llm-galgame-prototype",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "LLM-driven GalGame prototype with branch prefetching and media lookahead scheduling.",
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "tsx src/entrypoints/web.ts --dev",
    "dev:cli": "tsx src/entrypoints/cli.ts",
    "build": "tsc -p tsconfig.node.json && vite build",
    "build:node": "tsc -p tsconfig.node.json",
    "build:web": "vite build",
    "start": "npm run start:web",
    "start:web": "node dist/node/entrypoints/web.js",
    "start:cli": "node dist/node/entrypoints/cli.js",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "verify:voice-guide": "node scripts/verify-voice-guide.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "latest",
    "openai": "latest",
    "ws": "latest",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/ws": "latest",
    "fake-indexeddb": "latest",
    "happy-dom": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
